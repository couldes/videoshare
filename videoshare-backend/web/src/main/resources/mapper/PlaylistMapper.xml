<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.videoshare.web.mapper.PlaylistMapper">

    <resultMap id="PlaylistMap" type="com.videoshare.common.entity.Playlist">
        <id     column="playlist_id"  property="playlistId"/>
        <result column="user_id"      property="userId"/>
        <result column="title"        property="title"/>
        <result column="description"  property="description"/>
        <result column="cover_url"    property="coverUrl"/>
        <result column="is_private"   property="isPrivate"/>
        <result column="create_time"  property="createTime"/>
        <result column="update_time"  property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.videoshare.common.entity.Playlist"
            useGeneratedKeys="true" keyProperty="playlistId">
        INSERT INTO playlist (user_id, title, description, cover_url, is_private, create_time, update_time)
        VALUES (#{userId}, #{title}, #{description}, #{coverUrl}, #{isPrivate}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.videoshare.common.entity.Playlist">
        UPDATE playlist
        SET title       = #{title},
            description = #{description},
            is_private  = #{isPrivate},
            update_time = NOW()
        WHERE playlist_id = #{playlistId}
    </update>

    <delete id="deleteByPlaylistId">
        DELETE FROM playlist WHERE playlist_id = #{playlistId}
    </delete>

    <select id="selectByPlaylistId" resultMap="PlaylistMap">
        SELECT * FROM playlist WHERE playlist_id = #{playlistId}
    </select>

    <select id="selectByUserId" resultMap="PlaylistMap">
        SELECT * FROM playlist
        WHERE user_id = #{userId}
        <if test="isPrivate != null">AND is_private = #{isPrivate}</if>
        ORDER BY update_time DESC
    </select>

    <select id="countVideoById" resultType="Integer">
        SELECT COUNT(1) FROM playlist_video WHERE playlist_id = #{playlistId}
    </select>

    <update id="updateCoverUrl">
        UPDATE playlist SET cover_url = #{coverUrl} WHERE playlist_id = #{playlistId}
    </update>

</mapper>
