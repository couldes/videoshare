<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.videoshare.web.mapper.TranscodeJobMapper">

    <resultMap id="TranscodeJobMap" type="com.videoshare.common.entity.TranscodeJob">
        <id     column="job_id"       property="jobId"/>
        <result column="video_id"     property="videoId"/>
        <result column="status"       property="status"/>
        <result column="input_path"   property="inputPath"/>
        <result column="output_path"  property="outputPath"/>
        <result column="error_msg"    property="errorMsg"/>
        <result column="create_time"  property="createTime"/>
        <result column="update_time"  property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.videoshare.common.entity.TranscodeJob"
            useGeneratedKeys="true" keyProperty="jobId">
        INSERT INTO transcode_job
        (video_id, status, input_path, output_path, create_time)
        VALUES
        (#{videoId}, #{status}, #{inputPath}, #{outputPath}, NOW())
    </insert>

    <update id="updateStatus">
        UPDATE transcode_job
        SET status = #{status}, error_msg = #{errorMsg}
        WHERE job_id = #{jobId}
    </update>

    <select id="selectByVideoId" resultMap="TranscodeJobMap">
        SELECT * FROM transcode_job WHERE video_id = #{videoId}
    </select>

</mapper>
