<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  路径: admin/src/main/resources/mapper/CommentMapper.xml
  评论管理已收拢到 web 侧，本 Mapper 仅保留删视频级联清理 deleteByVideoId。
-->
<mapper namespace="com.videoshare.admin.mapper.CommentMapper">

    <!-- 删除某视频全部评论（物理删除，含子评论与已逻辑删除行；删视频时级联使用） -->
    <delete id="deleteByVideoId">
        DELETE FROM comment_info WHERE video_id = #{videoId}
    </delete>

</mapper>
